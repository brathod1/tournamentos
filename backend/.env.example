# Copy to .env for local dev, or set these as environment variables in your host
# (Render / Railway / Fly). Never commit real production values.

# MongoDB connection string.
#   local:  mongodb://localhost:27017
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL="mongodb://localhost:27017"

DB_NAME="tournamentos"

# Allowed browser origins for the API. '*' is fine locally; in production set your
# exact frontend URL, comma-separated if more than one.
#   e.g. CORS_ORIGINS="https://tournamentos.vercel.app"
CORS_ORIGINS="*"

# "development" or "production". In production the app refuses to start without JWT_SECRET.
ENVIRONMENT="development"

# Secret used to sign login tokens. Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out. Keep it out of version control.
JWT_SECRET=""

# How long a login lasts before the user must sign in again.
TOKEN_TTL_HOURS="12"
